  if (tipo === "VIS") return escenariosHL?.vis || null;
  if (tipo === "VIP") return escenariosHL?.vip || null;
  if (tipo === "BIESS") {
    return (
      escenariosHL?.biess ||
      escenariosHL?.biess_pref ||
      escenariosHL?.biess_std ||
      null
    );
  }
  if (
    tipo === "NORMAL" ||
    tipo === "PRIVADA" ||
    tipo === "COMERCIAL" ||
    tipo === "PRIVATE"
  ) {
    return escenariosHL?.comercial || null;
