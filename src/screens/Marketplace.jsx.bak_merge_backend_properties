function parseHLMoneyValue(value) {
  if (value === null || value === undefined || value === "") return null;

  if (typeof value === "number") {
    return Number.isFinite(value) && value > 0 ? value : null;
  }

  let raw = String(value).trim();
  if (!raw) return null;

  raw = raw.replace(/\$/g, "").replace(/\s/g, "");

  // Caso Ecuador/LatAm: "52.000" debe ser 52000, no 52.
  const hasDot = raw.includes(".");
  const hasComma = raw.includes(",");

  if (hasDot && !hasComma) {
    const parts = raw.split(".");
    const last = parts[parts.length - 1];

    if (last.length === 3 && parts.length >= 2) {
      raw = parts.join("");
    }
  }

  if (hasComma && !hasDot) {
    const parts = raw.split(",");
    const last = parts[parts.length - 1];

    if (last.length === 3 && parts.length >= 2) {
      raw = parts.join("");
    } else {
      raw = raw.replace(",", ".");
    }
  }

  if (hasDot && hasComma) {
    // "52.000,50" -> 52000.50
    raw = raw.replace(/\./g, "").replace(",", ".");
  }

  const n = Number(raw);
  return Number.isFinite(n) && n > 0 ? n : null;
}

function getPropertyPriceValue(property = {}) {
  return (
    parseHLMoneyValue(property?._normalizedPrice) ??
    parseHLMoneyValue(property?.precio) ??
    parseHLMoneyValue(property?.price) ??
    parseHLMoneyValue(property?.precioVenta) ??
    parseHLMoneyValue(property?.valor) ??
    parseHLMoneyValue(property?.valorVenta) ??
    parseHLMoneyValue(property?.listPrice) ??
    parseHLMoneyValue(property?.propertyPrice) ??
    parseHLMoneyValue(property?.precioReferencia) ??
    parseHLMoneyValue(property?.precio_ref) ??
    null
  );
}


