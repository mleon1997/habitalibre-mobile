function normalizeMortgageIdFromOption(option) {
  if (!option) return null;

  const explicit =
    option?.mortgageId ||
    option?.productId ||
    option?.product?.id ||
    null;

  if (explicit) return String(explicit).trim().toUpperCase();

  const haystack = [
    option?.scenarioId,
    option?.segment,
    option?.label,
    option?.productLabel,
    option?.tipoProducto,
  ]
    .filter(Boolean)
    .join(" ")
    .toUpperCase();

  const knownIds = [
    "BIESS_CREDICASA",
    "BIESS_VIS_VIP",
    "BIESS_MEDIA",
    "BIESS_ALTA",
    "BIESS_LUJO",
    "VIS_II",
    "PRIVATE",
    "VIP",
    "VIS",
    "BIESS",
  ];

  return knownIds.find((id) => haystack.includes(id)) || null;
}

function getMortgageOptionKey(option) {
  const mortgageId = normalizeMortgageIdFromOption(option);

  if (mortgageId) return `mortgage:${mortgageId}`;

  const scenarioId = option?.scenarioId
    ? String(option.scenarioId).trim().toUpperCase()
    : null;

  if (scenarioId) return `scenario:${scenarioId}`;

  return `${option?.banco || ""}-${option?.productLabel || option?.tipoProducto || ""}`;
}

function isSameMortgageOption(a, b) {
  if (!a || !b) return false;

  const mortgageA = normalizeMortgageIdFromOption(a);
  const mortgageB = normalizeMortgageIdFromOption(b);

  if (mortgageA && mortgageB) return mortgageA === mortgageB;

  return getMortgageOptionKey(a) === getMortgageOptionKey(b);
}

/* ---------------- mortgage marketplace helpers ---------------- */

function mortgagePriority(option) {
  const id = String(option?.mortgageId || "").toUpperCase();

  const map = {
    VIS: 1,
    VIP: 2,
    BIESS_VIS_VIP: 3,
    BIESS_CREDICASA: 4,
    BIESS_MEDIA: 5,
    BIESS_ALTA: 6,
    BIESS_LUJO: 7,
    PRIVATE: 8,
  };

  return map[id] || 99;
}

function getProgramMinByMortgageId(mortgageId) {
  const id = String(mortgageId || "").toUpperCase();

  const map = {
    BIESS_VIS_VIP: 71505,
    BIESS_MEDIA: 105001,
    BIESS_ALTA: 130001,
    BIESS_LUJO: 200000.01,
  };

  return map[id] ?? 0;
}

function mortgageContainsTarget(option, targetValue) {
  const target = Number(targetValue);

  if (!Number.isFinite(target) || target <= 0 || !option) return false;

  const min = getProgramMinByMortgageId(option?.mortgageId);

  const rawMax =
    option?.precioMaxPrograma ??
    option?.priceMaxProgram ??
    option?.programMax ??
    null;

  const max =
    rawMax == null || Number(rawMax) <= 0
      ? Infinity
      : Number(rawMax);

  return target >= min && target <= max;
}

