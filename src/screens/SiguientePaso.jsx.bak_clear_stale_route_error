function normalizeSelectedMortgageRoute(raw = null, selectedProperty = null) {
  if (!raw || typeof raw !== "object") return null;

  const id =
    raw.id ||
    raw._id ||
    raw.key ||
    raw.mortgageId ||
    raw.productId ||
    raw.tipoProducto ||
    raw.productLabel ||
    raw.label ||
    null;

  const productLabel =
    raw.productLabel ||
    raw.tipoProducto ||
    raw.label ||
    raw.nombre ||
    raw.name ||
    raw.mortgageId ||
    id ||
    "Ruta referencial";

  const providerLabel =
    raw.providerLabel ||
    raw.provider ||
    raw.banco ||
    raw.bank ||
    raw.entity ||
    raw.entidad ||
    "Vía entidad financiera";

  const annualRate =
    raw.annualRate ??
    raw.tasaAnual ??
    raw.rate ??
    raw.interestRate ??
    null;

  const termMonths =
    raw.termMonths ??
    raw.plazoMeses ??
    raw.months ??
    (raw.termYears || raw.plazoAnios || raw.plazoAños
      ? Number(raw.termYears || raw.plazoAnios || raw.plazoAños) * 12
      : null);

  const termYears =
    raw.termYears ??
    raw.plazoAnios ??
    raw.plazoAños ??
    (termMonths ? Math.round(Number(termMonths) / 12) : null);

  const monthlyPayment =
    raw.monthlyPayment ??
    raw.cuotaMensual ??
    raw.cuota ??
    raw.estimatedMonthlyPayment ??
    null;

  const loanAmount =
    raw.loanAmount ??
    raw.montoPrestamo ??
    raw.montoFinanciar ??
    raw.montoFinanciado ??
    raw.amount ??
    null;

  return {
    id: id ? String(id) : null,
    key: id ? String(id) : null,
    mortgageId: id ? String(id) : null,
    productLabel,
    tipoProducto: productLabel,
    providerLabel,
    provider: providerLabel,
    annualRate,
    tasaAnual: annualRate,
    termMonths,
    plazoMeses: termMonths,
    termYears,
    plazoAnios: termYears,
    monthlyPayment,
    cuota: monthlyPayment,
    cuotaMensual: monthlyPayment,
    loanAmount,
    montoFinanciar: loanAmount,
    montoFinanciado: loanAmount,
    propertyId: selectedProperty?.id || null,
    propertyTitle: selectedProperty?.title || null,
    propertyPrice: selectedProperty?.price ?? null,
    status: "selected",
    confirmed: true,
    selectedAt: raw.selectedAt || new Date().toISOString(),
    source: raw.source || "frontend_selected_route",
    raw,
  };
}


