function toMoneyNumber(value) {
  const n = Number(value);
  return Number.isFinite(n) && n > 0 ? n : null;
}

function getSelectedPropertyTitle(property, journey) {
  return (
    property?.nombre ||
    property?.title ||
    property?.name ||
    property?.proyecto ||
    journey?.propiedadNombre ||
    journey?.selectedPropertyName ||
    "Propiedad elegida"
  );
}

function getSelectedPropertyPrice(property, journey) {
  return (
    toMoneyNumber(property?.precio) ??
    toMoneyNumber(property?.price) ??
    toMoneyNumber(property?.valor) ??
    toMoneyNumber(property?.propertyPrice) ??
    toMoneyNumber(journey?.propiedadPrecio) ??
    toMoneyNumber(journey?.selectedPropertyPrice) ??
    null
  );
}

function getAvailableEntry(snapshot, journey, property) {
  return (
    toMoneyNumber(property?.entradaDisponible) ??
    toMoneyNumber(property?.availableEntry) ??
    toMoneyNumber(journey?.entradaDisponible) ??
    toMoneyNumber(journey?.input?.entrada) ??
    toMoneyNumber(snapshot?.input?.entrada) ??
    toMoneyNumber(snapshot?.perfilInput?.entrada) ??
    toMoneyNumber(snapshot?.__entrada?.entrada) ??
    toMoneyNumber(snapshot?.output?.input?.entrada) ??
    toMoneyNumber(snapshot?.output?.perfilInput?.entrada) ??
    toMoneyNumber(snapshot?.output?.__entrada?.entrada) ??
    toMoneyNumber(snapshot?.inputNormalizado?.entrada) ??
    toMoneyNumber(snapshot?.output?.inputNormalizado?.entrada) ??
    null
  );
}

function getRequiredEntry(propertyPrice, property) {
  return (
    toMoneyNumber(property?.entradaRequerida) ??
    toMoneyNumber(property?.requiredEntry) ??
    toMoneyNumber(property?.entradaTotal) ??
    toMoneyNumber(property?.evaluacionEntrada?.entradaRequerida) ??
    (propertyPrice ? Math.round(propertyPrice * 0.1) : null)
  );
}

function getRouteObjective(snapshot, property, maxCompra) {
  return (
    toMoneyNumber(property?.rutaObjetivo) ??
    toMoneyNumber(property?.capacidadObjetivo) ??
    toMoneyNumber(property?.capacidadObjetivoCompra) ??
    toMoneyNumber(property?.selectedMatchPayload?.capacidadObjetivo) ??
    toMoneyNumber(property?.match?.capacidadObjetivo) ??
    toMoneyNumber(snapshot?.financialCapacity?.debtReduction?.estimatedMaxPropertyValue) ??
    toMoneyNumber(snapshot?.output?.financialCapacity?.debtReduction?.estimatedMaxPropertyValue) ??
    toMoneyNumber(snapshot?.financialCapacity?.plannedEntry?.estimatedMaxPropertyValue) ??
    toMoneyNumber(snapshot?.output?.financialCapacity?.plannedEntry?.estimatedMaxPropertyValue) ??
    toMoneyNumber(maxCompra) ??
    null
  );
}

