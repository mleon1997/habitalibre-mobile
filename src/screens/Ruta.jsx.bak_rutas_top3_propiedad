export default function Ruta() {
  const nav = useNavigate();

  const snapshot = useMemo(() => loadOwnedData(LS_SNAPSHOT), []);
  const journey = useMemo(() => loadOwnedData(LS_JOURNEY), []);

  const selectedPropertyRef = useMemo(
    () => loadOwnedData(LS_SELECTED_PROPERTY),
    []
  );

  const selectedMortgageRoute = useMemo(
    () => loadOwnedData(LS_SELECTED_MORTGAGE_ROUTE),
    []
  );

  const docsChecklist = useMemo(
    () => loadOwnedData(LS_DOCS_CHECKLIST) || {},
    []
  );

  const hasEvaluation = hasUnlockedEvaluation(snapshot);

  const cuota = hasEvaluation
    ? snapshot?.cuotaMensual ??
      snapshot?.kpis?.cuotaMensual ??
      snapshot?.resultado?.cuotaMensual ??
      snapshot?.cuotaEstimada ??
      snapshot?.financialCapacity?.estimatedMonthlyPayment ??
      snapshot?.output?.financialCapacity?.estimatedMonthlyPayment ??
      snapshot?.bestMortgage?.cuota ??
      null
    : null;

  const maxCompra = hasEvaluation
    ? snapshot?.maxCompra ??
      snapshot?.kpis?.maxCompra ??
      snapshot?.resultado?.maxCompra ??
      snapshot?.precioMaxVivienda ??
      snapshot?.financialCapacity?.estimatedMaxPropertyValue ??
      snapshot?.output?.financialCapacity?.estimatedMaxPropertyValue ??
      snapshot?.montoMaximo ??
      null
    : null;

  const visTag = hasEvaluation
    ? snapshot?.programa ??
      snapshot?.kpis?.programa ??
      snapshot?.resultado?.programa ??
      snapshot?.productoSugerido ??
      snapshot?.bestMortgage?.segment ??
      snapshot?.output?.bestMortgage?.segment ??
      selectedMortgageRoute?.productLabel ??
      "VIS"
    : "—";

  const compatPct = hasEvaluation
    ? toPct(
        snapshot?.probAprobacion ??
          snapshot?.kpis?.probAprobacion ??
          snapshot?.resultado?.probAprobacion ??
          snapshot?.score ??
          snapshot?.output?.score
      )
    : null;

  const compat = compatMeta(compatPct);

  const matchedPropsFromJourney =
    journey?.match?.propiedades?.length ??
    journey?.match?.items?.length ??
    journey?.matchCount ??
    null;

  const matchedPropsFromSnapshot = hasEvaluation
    ? snapshot?.matchedProperties?.length ??
      snapshot?.output?.matchedProperties?.length ??
      snapshot?.plan?.routeSignals?.matchedProperties?.length ??
      snapshot?.routeSignals?.matchedProperties?.length ??
      null
    : null;

  const propsCount = matchedPropsFromJourney ?? matchedPropsFromSnapshot ?? null;

  const selectedPropertyId =
    selectedPropertyRef?.id || journey?.propiedadId || null;

  const selectedPropertyStatus =
    journey?.selectedPropertyStatus ||
    selectedPropertyRef?.status ||
    null;

  const selectedPropertyStatusMeta = getSelectedPropertyStatusMeta(
    selectedPropertyStatus,
    Boolean(selectedPropertyId)
  );

  const hasChosenProperty = Boolean(
    journey?.propiedadElegida || journey?.propiedadId || selectedPropertyId
  );

  const selectedPropertyName = getSelectedPropertyTitle(
    selectedPropertyRef,
    journey
  );

  const selectedPropertyPrice = getSelectedPropertyPrice(
    selectedPropertyRef,
    journey
  );

  const selectedPropertyEntryAvailable = getAvailableEntry(
    snapshot,
    journey,
    selectedPropertyRef
  );

  const selectedPropertyEntryRequired = getRequiredEntry(
    selectedPropertyPrice,
    selectedPropertyRef
  );

  const selectedPropertyLoanAmount =
    selectedPropertyPrice != null
      ? Math.max(
          0,
          selectedPropertyPrice - (selectedPropertyEntryAvailable || 0)
        )
      : null;

  const selectedPropertyRouteObjective = getRouteObjective(
    snapshot,
    selectedPropertyRef,
    maxCompra
  );

  const selectedPropertyRouteGap =
    selectedPropertyPrice != null && selectedPropertyRouteObjective != null
      ? Math.max(0, selectedPropertyPrice - selectedPropertyRouteObjective)
      : null;

  const hasPropertyFinancingContext = hasEvaluation && hasChosenProperty;

  const hasConfirmedMortgageRoute = Boolean(
    selectedMortgageRoute?.status === "confirmed" ||
      selectedMortgageRoute?.status === "selected" ||
      journey?.mortgageRouteConfirmed === true ||
      hasPropertyFinancingContext
  );

  const mortgageRouteLabel = selectedMortgageRoute
    ? getMortgageRouteLabel(selectedMortgageRoute)
    : null;

  const docsDone = Object.values(docsChecklist).filter(Boolean).length;
  const docsTotal = 10;
  const docsProgress = Math.max(
    0,
    Math.min(100, Math.round((docsDone / docsTotal) * 100))
  );

  const docsReady = docsProgress >= 60;

  const caseReadinessStatus = hasEvaluation
    ? getCaseReadinessStatus({
        hasChosenProperty,
        selectedPropertyStatus,
        hasConfirmedMortgageRoute,
        docsReady,
      })
    : "no_listo";

  const activationRequestedAt = journey?.activationRequestedAt || null;
  const projectSubmittedAt = journey?.projectSubmittedAt || null;
  const bankSubmittedAt = journey?.bankSubmittedAt || null;

  const caseSteps = getCaseStepMeta({
    caseReadinessStatus,
    activationRequestedAt,
    projectSubmittedAt,
    bankSubmittedAt,
  });

const flags = {
  orientacionInicial: hasEvaluation,

  // OJO:
  // Tener propiedades sugeridas NO significa que el usuario ya exploró Match.
  // Solo marcamos Match como completado si el usuario realmente lo visitó,
  // eligió una propiedad o avanzó a guardar una ruta.
  matchExplorado:
    hasEvaluation &&
    Boolean(
      journey?.matchExplorado ||
        journey?.match?.visto ||
        hasChosenProperty ||
        hasConfirmedMortgageRoute
    ),

  propiedadElegida: hasEvaluation && hasChosenProperty,

  rutaHipotecariaGuardada:
    hasEvaluation && hasChosenProperty && hasConfirmedMortgageRoute,

  docsPreparados:
    hasEvaluation && hasChosenProperty && hasConfirmedMortgageRoute && docsReady,

  casoRevisado:
    hasEvaluation &&
    (caseReadinessStatus === "listo_para_revision_habitalibre" ||
      Boolean(activationRequestedAt) ||
      Boolean(projectSubmittedAt) ||
      Boolean(bankSubmittedAt)),

  casoCompartido: hasEvaluation && Boolean(activationRequestedAt),

  estadoRevision:
    hasEvaluation &&
    (Boolean(activationRequestedAt) ||
      Boolean(projectSubmittedAt) ||
      Boolean(bankSubmittedAt)),
};

  const stepsOrder = [
    "orientacionInicial",
    "matchExplorado",
    "propiedadElegida",
    "rutaHipotecariaGuardada",
    "docsPreparados",
    "casoRevisado",
    "casoCompartido",
    "estadoRevision",
  ];

  const doneCount = stepsOrder.filter((k) => flags[k]).length;
  const progressPct = clamp(
    Math.round((doneCount / stepsOrder.length) * 100),
    0,
    100
  );
  const remaining = stepsOrder.length - doneCount;

  const nextStepKey = stepsOrder.find((k) => !flags[k]) || "estadoRevision";

  const nextStepLabel =
    nextStepKey === "orientacionInicial"
      ? "Empezar evaluación"
      : nextStepKey === "matchExplorado"
      ? "Explorar propiedades"
      : nextStepKey === "propiedadElegida"
      ? "Elegir una propiedad"
      : nextStepKey === "rutaHipotecariaGuardada"
      ? "Ver financiamiento"
      : nextStepKey === "docsPreparados"
      ? "Preparar documentos"
      : nextStepKey === "casoRevisado"
      ? "Revisar preparación"
      : nextStepKey === "casoCompartido"
      ? "Compartir caso con HabitaLibre"
      : "Estado de revisión";

  const goNext = () => {
    if (nextStepKey === "orientacionInicial") nav("/journey/full");
    else if (nextStepKey === "matchExplorado") nav("/marketplace");
    else if (nextStepKey === "propiedadElegida") nav("/marketplace");
    else if (nextStepKey === "rutaHipotecariaGuardada") nav("/ruta");
    else if (nextStepKey === "docsPreparados") nav("/checklist-documentos");
    else if (nextStepKey === "casoRevisado") nav("/siguiente-paso");
    else if (nextStepKey === "casoCompartido") nav("/siguiente-paso");
    else nav("/caso");
  };

  return (
    <Screen
      style={{
        paddingTop: 78,
        paddingBottom: 110,
      }}
    >
      <Card
        style={{
          padding: "18px 18px 18px",
          boxShadow: "0 14px 36px rgba(0,0,0,0.22)",
        }}
      >
        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            gap: 14,
            alignItems: "flex-start",
          }}
        >
          <div style={{ minWidth: 0, flex: 1 }}>
            <div
              style={{
                fontSize: 13,
                color: "rgba(148,163,184,0.95)",
                fontWeight: 850,
                marginBottom: 8,
              }}
            >
              Ruta
            </div>

            <div
              style={{
                fontSize: 20,
                fontWeight: 980,
                letterSpacing: 0.2,
                lineHeight: 1.08,
              }}
            >
              Tu camino hacia vivienda propia
            </div>

            <div
              style={{
                marginTop: 6,
                fontSize: 13.5,
                color: "rgba(148,163,184,0.95)",
                lineHeight: 1.4,
                maxWidth: 360,
              }}
            >
              Pasos claros, estimaciones referenciales y una ruta más ordenada.
            </div>
          </div>

          <div
            style={{
              display: "flex",
              flexDirection: "column",
              gap: 8,
              alignItems: "flex-end",
              flexShrink: 0,
            }}
          >
            <Chip tone={compat.tone}>
              Compatibilidad {compat.label}
              {compatPct != null ? ` · ${compatPct}%` : ""}
            </Chip>
            <Chip tone="neutral">{progressPct}% completado</Chip>
          </div>
        </div>

        <FinancialDisclaimer compact />

        <div style={{ marginTop: 14 }}>
          <div
            style={{
              display: "flex",
              justifyContent: "space-between",
              marginBottom: 8,
            }}
          >
            <div
              style={{
                fontSize: 12,
                color: "rgba(148,163,184,0.95)",
                fontWeight: 800,
              }}
            >
              Progreso
            </div>
            <div
              style={{
                fontSize: 12,
                color: "rgba(226,232,240,0.92)",
                fontWeight: 950,
              }}
            >
              {progressPct}%
            </div>
          </div>

          <ProgressBar value={progressPct} />

          <div
            style={{
              marginTop: 10,
              fontSize: 12.5,
              color: "rgba(148,163,184,0.95)",
              lineHeight: 1.4,
            }}
          >
            {remaining > 0 ? (
              <>
                Te faltan{" "}
                <b style={{ color: "rgba(226,232,240,0.95)" }}>
                  {remaining}
                </b>{" "}
                pasos para continuar.
              </>
            ) : (
              <>¡Listo! Ya completaste todos los pasos de preparación.</>
            )}
          </div>

          <div style={{ marginTop: 14 }}>
            <PrimaryButton onClick={goNext} style={{ padding: "14px 16px" }}>
              <span
                style={{ display: "inline-flex", alignItems: "center", gap: 8 }}
              >
                Siguiente paso: {nextStepLabel}
                <ArrowRight size={16} />
              </span>
            </PrimaryButton>
          </div>
        </div>
      </Card>

      {hasChosenProperty ? (
        <Card
          style={{
            marginTop: 18,
            padding: "18px",
            background:
              "linear-gradient(180deg, rgba(37,211,166,0.10), rgba(255,255,255,0.045))",
            border: "1px solid rgba(37,211,166,0.24)",
            boxShadow: "0 14px 36px rgba(0,0,0,0.22)",
          }}
        >
          <div
            style={{
              display: "flex",
              justifyContent: "space-between",
              gap: 12,
              alignItems: "flex-start",
            }}
          >
            <div style={{ minWidth: 0, flex: 1 }}>
              <div
                style={{
                  fontSize: 12,
                  color: "rgba(148,163,184,0.95)",
                  fontWeight: 900,
                }}
              >
                Financiamiento para esta propiedad
              </div>

              <div
                style={{
                  marginTop: 8,
                  fontSize: 20,
                  fontWeight: 980,
                  lineHeight: 1.15,
                  color: "rgba(226,232,240,0.98)",
                }}
              >
                {selectedPropertyName}
              </div>

              <div
                style={{
                  marginTop: 8,
                  fontSize: 13.5,
                  color: "rgba(203,213,225,0.92)",
                  lineHeight: 1.4,
                }}
              >
                Esta lectura combina tu perfil con la propiedad que elegiste.
                La ruta final dependerá de la entidad financiera.
              </div>
            </div>

            <Chip tone={selectedPropertyRouteGap > 0 ? "neutral" : "good"}>
              {selectedPropertyRouteGap > 0 ? "Requiere preparación" : "Alineada"}
            </Chip>
          </div>

          <div
            style={{
              marginTop: 16,
              display: "grid",
              gridTemplateColumns: "1fr 1fr",
              gap: 10,
            }}
          >
            <div
              style={{
                padding: 13,
                borderRadius: 16,
                background: "rgba(15,23,42,0.48)",
                border: "1px solid rgba(148,163,184,0.16)",
              }}
            >
              <div style={{ fontSize: 11.5, color: "rgba(148,163,184,0.92)", fontWeight: 850 }}>
                Precio propiedad
              </div>
              <div style={{ marginTop: 5, fontSize: 18, fontWeight: 980 }}>
                {selectedPropertyPrice ? moneyUSD(selectedPropertyPrice) : "—"}
              </div>
            </div>

            <div
              style={{
                padding: 13,
                borderRadius: 16,
                background: "rgba(15,23,42,0.48)",
                border: "1px solid rgba(148,163,184,0.16)",
              }}
            >
              <div style={{ fontSize: 11.5, color: "rgba(148,163,184,0.92)", fontWeight: 850 }}>
                Ruta objetivo
              </div>
              <div style={{ marginTop: 5, fontSize: 18, fontWeight: 980 }}>
                {selectedPropertyRouteObjective
                  ? moneyUSD(selectedPropertyRouteObjective)
                  : maxCompra
                  ? moneyUSD(maxCompra)
                  : "—"}
              </div>
            </div>

            <div
              style={{
                padding: 13,
                borderRadius: 16,
                background: "rgba(15,23,42,0.48)",
                border: "1px solid rgba(148,163,184,0.16)",
              }}
            >
              <div style={{ fontSize: 11.5, color: "rgba(148,163,184,0.92)", fontWeight: 850 }}>
                Entrada disponible
              </div>
              <div style={{ marginTop: 5, fontSize: 18, fontWeight: 980 }}>
                {selectedPropertyEntryAvailable
                  ? moneyUSD(selectedPropertyEntryAvailable)
                  : "—"}
              </div>
            </div>

            <div
              style={{
                padding: 13,
                borderRadius: 16,
                background: "rgba(15,23,42,0.48)",
                border: "1px solid rgba(148,163,184,0.16)",
              }}
            >
              <div style={{ fontSize: 11.5, color: "rgba(148,163,184,0.92)", fontWeight: 850 }}>
                Monto a financiar
              </div>
              <div style={{ marginTop: 5, fontSize: 18, fontWeight: 980 }}>
                {selectedPropertyLoanAmount
                  ? moneyUSD(selectedPropertyLoanAmount)
                  : "Por definir"}
              </div>
            </div>
          </div>

          <div
            style={{
              marginTop: 14,
              padding: 14,
              borderRadius: 18,
              background:
                selectedPropertyRouteGap > 0
                  ? "rgba(245,158,11,0.08)"
                  : "rgba(34,197,94,0.08)",
              border:
                selectedPropertyRouteGap > 0
                  ? "1px solid rgba(245,158,11,0.22)"
                  : "1px solid rgba(34,197,94,0.18)",
              color: "rgba(226,232,240,0.94)",
              fontSize: 13,
              lineHeight: 1.42,
            }}
          >
            {selectedPropertyRouteGap > 0 ? (
              <>
                Esta propiedad está aproximadamente{" "}
                <b>{moneyUSD(selectedPropertyRouteGap)}</b> sobre tu ruta objetivo.
                Te conviene fortalecer perfil, reducir deudas o comparar una unidad
                de menor precio.
              </>
            ) : (
              <>
                Esta propiedad se ve alineada de forma referencial con tu ruta actual.
                El siguiente paso es preparar documentos y validar condiciones finales.
              </>
            )}
          </div>

          <div style={{ marginTop: 14, display: "grid", gap: 10 }}>
            <PrimaryButton
              onClick={() =>
                nav(selectedPropertyId ? `/property/${selectedPropertyId}` : "/marketplace")
              }
            >
              Ver detalle de la propiedad
            </PrimaryButton>

            <SecondaryButton onClick={() => nav("/marketplace")}>
              Comparar otras propiedades
            </SecondaryButton>
          </div>
        </Card>
      ) : (
        <Card
          style={{
            marginTop: 18,
            padding: "18px",
          }}
        >
          <div style={{ fontSize: 12, color: "rgba(148,163,184,0.95)", fontWeight: 900 }}>
            Financiamiento
          </div>
          <div style={{ marginTop: 8, fontSize: 20, fontWeight: 980, lineHeight: 1.15 }}>
            Elige una propiedad para aterrizar tu ruta
          </div>
          <div style={{ marginTop: 8, fontSize: 13.5, color: "rgba(148,163,184,0.95)", lineHeight: 1.4 }}>
            La lectura de financiamiento depende de tu perfil y del inmueble específico que elijas.
          </div>
          <div style={{ marginTop: 14 }}>
            <PrimaryButton onClick={() => nav("/marketplace")}>
              Explorar propiedades
            </PrimaryButton>
          </div>
        </Card>
      )}

      <div
        style={{
          marginTop: 18,
          display: "flex",
          flexDirection: "column",
          gap: 16,
        }}
      >
        <StepTimelineCard
          stepNum={1}
          title="Orientación inicial"
          subtitle={
            hasEvaluation
              ? "Tu perfil ya tiene una estimación referencial lista."
              : "Completa tu evaluación para abrir tu ruta referencial."
          }
          status={hasEvaluation ? "done" : "next"}
          featured={!hasEvaluation}
          icon={<CheckCircle2 size={13} />}
          rightChips={
            <>
              <RightMetric>{hasEvaluation ? "Score" : "Pendiente"}</RightMetric>
              <RightMetric>
                {hasEvaluation && cuota ? `Cuota ref. ${moneyUSD(cuota)}` : "Cuota ref. —"}
              </RightMetric>
            </>
          }
          ctaLabel={hasEvaluation ? "Ver mi orientación" : "Empezar evaluación"}
          onClick={() => nav(hasEvaluation ? "/" : "/journey/full")}
          hint={
            hasEvaluation
              ? "Este paso resume tu rango estimado, cuota referencial y siguiente paso sugerido."
              : "Aquí se activa tu rango estimado, tu cuota referencial y tu siguiente mejor paso."
          }
        />

        <StepTimelineCard
          stepNum={2}
          title="Explorar propiedades"
          subtitle="Compara propiedades según tu capacidad actual y tu ruta de preparación."
          status={
            !hasEvaluation
              ? "locked"
              : flags.matchExplorado
              ? "done"
              : "next"
          }
          featured={hasEvaluation && !flags.matchExplorado}
          icon={<MapPinned size={13} />}
          rightChips={
            <>
              <RightMetric>{hasEvaluation ? visTag : "—"}</RightMetric>
              <RightMetric>
                {hasEvaluation && maxCompra ? `Hasta ${moneyUSD(maxCompra)}` : "Hasta —"}
              </RightMetric>
            </>
          }
          ctaLabel={propsCount ? `Ver ${propsCount} propiedades` : "Ir a Match"}
          onClick={() => nav("/marketplace")}
          disabled={!hasEvaluation}
          hint={
            hasEvaluation
              ? cuota && maxCompra
                ? <>
                    Tu rango estimado:{" "}
                    <b style={{ color: "rgba(226,232,240,0.95)" }}>
                      {moneyUSD(maxCompra)}
                    </b>{" "}
                    · cuota referencial desde{" "}
                    <b style={{ color: "rgba(226,232,240,0.95)" }}>
                      {moneyUSD(cuota)}
                    </b>
                    .
                  </>
                : "Aquí ves propiedades alineadas con tu perfil y tu ruta de preparación."
              : "Primero necesitas completar tu evaluación para ver opciones alineadas con tu perfil."
          }
        />

        <StepTimelineCard
          stepNum={3}
          title="Elegir una propiedad"
          subtitle={
            flags.propiedadElegida
              ? "Ya elegiste una propiedad para continuar tu ruta."
              : "Elige una propiedad para aterrizar tu ruta de financiamiento."
          }
          status={
            !hasEvaluation
              ? "locked"
              : flags.propiedadElegida
              ? "done"
              : flags.matchExplorado
              ? "pending"
              : "locked"
          }
          icon={<Home size={13} />}
          rightChips={
            <RightMetric
              tone={flags.propiedadElegida ? selectedPropertyStatusMeta.tone : "neutral"}
            >
              {flags.propiedadElegida
                ? selectedPropertyStatusMeta.short
                : "Pendiente"}
            </RightMetric>
          }
          ctaLabel={
            flags.propiedadElegida ? "Ver propiedad elegida" : "Elegir en Match"
          }
          onClick={() =>
            nav(
              flags.propiedadElegida && selectedPropertyId
                ? `/property/${selectedPropertyId}`
                : "/marketplace"
            )
          }
          disabled={!hasEvaluation || !flags.matchExplorado}
          hint={
            flags.propiedadElegida
              ? selectedPropertyStatusMeta.hint
              : "La ruta de financiamiento depende de tu perfil y de la propiedad que elijas."
          }
        />

        <StepTimelineCard
          stepNum={4}
          title="Financiamiento de esta propiedad"
          subtitle={
            flags.rutaHipotecariaGuardada
              ? "Ya tienes una lectura de financiamiento para tu propiedad elegida."
              : "Revisa cómo se ve el financiamiento estimado para la propiedad que elegiste."
          }
          status={
            !hasEvaluation
              ? "locked"
              : flags.rutaHipotecariaGuardada
              ? "done"
              : flags.propiedadElegida
              ? "next"
              : "locked"
          }
          featured={
            hasEvaluation &&
            flags.propiedadElegida &&
            !flags.rutaHipotecariaGuardada
          }
          icon={<ShieldCheck size={13} />}
          rightChips={
            <>
              <RightMetric tone={flags.rutaHipotecariaGuardada ? "good" : "neutral"}>
                {flags.rutaHipotecariaGuardada ? "Guardada" : "Pendiente"}
              </RightMetric>
              <RightMetric>
                {selectedMortgageRoute?.productLabel ||
                  selectedMortgageRoute?.tipoProducto ||
                  visTag ||
                  "Ruta ref."}
              </RightMetric>
            </>
          }
          ctaLabel={
            flags.rutaHipotecariaGuardada
              ? "Ver financiamiento"
              : "Ver financiamiento"
          }
          onClick={() =>
            nav(selectedPropertyId ? `/property/${selectedPropertyId}` : "/marketplace")
          }
          disabled={!hasEvaluation || !flags.propiedadElegida}
          hint={
            flags.rutaHipotecariaGuardada
              ? `${mortgageRouteLabel || "Ruta hipotecaria referencial guardada"}${
                  selectedMortgageRoute?.cuota
                    ? ` · cuota ref. ${moneyUSD(selectedMortgageRoute.cuota)}`
                    : ""
                }${
                  selectedMortgageRoute?.annualRate || selectedMortgageRoute?.tasaAnual
                    ? ` · tasa ref. ${(Number(
                        selectedMortgageRoute.annualRate ||
                          selectedMortgageRoute.tasaAnual
                      ) <= 1
                        ? Number(
                            selectedMortgageRoute.annualRate ||
                              selectedMortgageRoute.tasaAnual
                          ) * 100
                        : Number(
                            selectedMortgageRoute.annualRate ||
                              selectedMortgageRoute.tasaAnual
                          )
                      ).toFixed(2)}%`
                    : ""
                }`
              : "Antes de preparar documentos, revisa cómo se ve esta propiedad frente a tu perfil y tu entrada disponible."
          }
        />

        <StepTimelineCard
          stepNum={5}
          title="Preparar documentos"
          subtitle="Te mostramos qué podrías tener listo si decides avanzar con esta propiedad."
          status={
            !hasEvaluation
              ? "locked"
              : flags.docsPreparados
              ? "done"
              : flags.rutaHipotecariaGuardada
              ? "pending"
              : "locked"
          }
          icon={<FileText size={13} />}
          rightChips={
            <RightMetric tone={flags.docsPreparados ? "good" : "neutral"}>
              {flags.docsPreparados ? "Listo" : "Pendiente"}
            </RightMetric>
          }
          ctaLabel="Ver checklist"
          onClick={() => nav("/checklist-documentos")}
          disabled={!hasEvaluation || !flags.rutaHipotecariaGuardada}
          hint={
            docsDone > 0
              ? `Tienes ${docsDone} de ${docsTotal} ítems marcados en tu checklist.`
              : "Mientras más preparado estés, más fácil será dar el siguiente paso."
          }
        />

        <StepTimelineCard
          stepNum={6}
          title="Revisar preparación del caso"
          subtitle="El sistema revisa si tu propiedad elegida, tu ruta referencial y tu preparación actual ya son suficientes para compartir tu caso con HabitaLibre."
          status={caseSteps.validateStatus}
          featured={caseSteps.validateStatus === "next"}
          icon={<ShieldCheck size={13} />}
          rightChips={
            <RightMetric tone={caseSteps.validateStatus === "done" ? "good" : "neutral"}>
              {caseSteps.validateChip}
            </RightMetric>
          }
          ctaLabel={caseSteps.validateCta}
          onClick={() => nav(hasEvaluation ? "/siguiente-paso" : "/journey/full")}
          disabled={!hasEvaluation || !flags.docsPreparados}
          hint={
            hasEvaluation
              ? caseSteps.validateHint
              : "Primero necesitas una evaluación referencial para abrir este paso."
          }
        />

        <StepTimelineCard
          stepNum={7}
          title="Compartir caso con HabitaLibre"
          subtitle="Cuando tu caso esté listo, podrás compartirlo con HabitaLibre para revisión interna."
          status={caseSteps.sendStatus}
          featured={caseSteps.sendStatus === "next"}
          icon={<Send size={13} />}
          rightChips={
            <RightMetric tone={caseSteps.sendStatus === "done" ? "good" : "neutral"}>
              {caseSteps.sendChip}
            </RightMetric>
          }
          ctaLabel={caseSteps.sendCta}
          onClick={() => nav(hasEvaluation ? "/siguiente-paso" : "/journey/full")}
          disabled={!hasEvaluation || caseSteps.sendStatus === "locked"}
          hint={
            hasEvaluation
              ? caseSteps.sendHint
              : "Este paso solo se habilita después de completar tu evaluación."
          }
        />

        <StepTimelineCard
          stepNum={8}
          title="Estado de revisión"
          subtitle="Aquí verás cuando HabitaLibre reciba tu caso y cómo va avanzando la revisión interna."
          status={caseSteps.statusStatus}
          icon={<BadgeCheck size={13} />}
          rightChips={
            <RightMetric
              tone={
                caseSteps.statusStatus === "done" || caseSteps.statusStatus === "next"
                  ? "good"
                  : "neutral"
              }
            >
              {caseSteps.statusChip}
            </RightMetric>
          }
          ctaLabel={caseSteps.statusCta}
          onClick={() => nav(hasEvaluation ? "/caso" : "/journey/full")}
          disabled={!hasEvaluation || caseSteps.statusStatus === "locked"}
          hint={
            hasEvaluation
              ? caseSteps.statusHint
              : "Este seguimiento aparecerá cuando ya exista una evaluación y un caso activo."
          }
        />
      </div>
    </Screen>
  );
}